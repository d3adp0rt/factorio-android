<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- legacy storage access: lets the user import own savegames from /sdcard if he wants to -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        tools:ignore="DataExtractionRules,GoogleAppIndexingWarning">

        <activity
            android:name=".ControlsEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:label="@string/controls_edit" />

        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/LauncherTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The X11 server window (Lorie, comes from the :lorie library). Its launcher
             intent-filter is dropped, so the app starts with LauncherActivity instead. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:roundIcon="@mipmap/ic_launcher"
            android:supportsPictureInPicture="true"
            android:taskAffinity=".MainActivity"
            android:theme="@style/LorieAppTheme"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            tools:node="replace" />

        <service
            android:name=".GameService"
            android:exported="false" />

        <!-- Lorie X server lives in its own process of this app (no app_process tricks). -->
        <service
            android:name=".XServerService"
            android:exported="false"
            android:process=":x11" />
    </application>
</manifest>
